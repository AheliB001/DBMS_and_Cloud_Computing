<!DOCTYPE html>
<html>
<head>
    <!-- Meta information -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Homepage</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="mystyle.css">

    <!-- Internal CSS -->
    <style>
        h2 {
            color: green;
        }
    </style>
</head>

<body>

    <h1 style="color: blue; text-align: center;">Welcome to My Homepage</h1>

    <!-- Formatting -->
    <p>
        This is <b>bold</b>,
        <i>italic</i> and
        <em>emphasized</em> text.
    </p>

    <!-- Image (relative path) -->
    <img src="photo.jpg"
         alt="My photo"
         width="200"
         height="200"
         style="float: right;">

    <p>This is my first webpage.</p>

    <!-- Image (absolute path) -->
    <img src="https://via.placeholder.com/150"
         alt="Sample image">

    <hr>

    <!-- External link -->
    <p>
        <a href="https://www.ibab.ac.in" target="_blank">
            Click here to visit my institute
        </a>
    </p>

    <!-- Internal links -->
    <p>
        <a href="#section1">Go to Section 1</a> |
        <a href="#end">Go to End</a>
    </p>

    <!-- Div with ID -->
    <div id="section1">
        <h2>Programs Offered</h2>

        <!-- Ordered list -->
        <ol>
            <li>MSc Biology</li>
            <li>MSc Biotechnology</li>
        </ol>

        <!-- Unordered list -->
        <ul>
            <li>Library</li>
            <li>Hostel</li>
        </ul>
    </div>

    <!-- Table -->
    <h2>Student Details</h2>
    <table border="1" cellpadding="5">
        <tr>
            <th>Course</th>
            <th>Students</th>
        </tr>
        <tr>
            <td>MSc BDB</td>
            <td>27</td>
        </tr>
        <tr>
            <td>MSc BTBI</td>
            <td>40</td>
        </tr>
    </table>

    <!-- Pre and code -->
    <h2>Code Example</h2>

    <pre>
int i = 0;
i = i + 1;
    </pre>

    <code>int i = 0;</code>

    <hr>

    <div id="end">
        <p>This is the end of my webpage.</p>
        <a href="#top">Back to top</a>
    </div>

</body>
</html>
